# Google OAuth client ID for the web app's Google Identity Services flow.
# Create one at https://console.cloud.google.com/apis/credentials
# (Web application type; add your GitHub Pages origin to Authorized JS origins).
VITE_GOOGLE_CLIENT_ID=

# Google API key ("developer key") for the Google Drive Picker.
# Same Cloud project as the client ID; restrict it to your origins + the
# Picker API. Without it, "Select a Doc from Drive" is disabled.
VITE_GOOGLE_API_KEY=

# Optional: Google Cloud Project NUMBER used as the Picker appId so a picked
# file is granted to this app under the drive.file scope. If unset, it's
# derived automatically from the numeric prefix of VITE_GOOGLE_CLIENT_ID.
VITE_GOOGLE_APP_ID=
